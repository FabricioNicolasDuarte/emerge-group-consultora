# Copiá a .env y completá con tu proyecto Supabase.
# Dashboard: https://supabase.com/dashboard → Project Settings → API

NUXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=eyJ...tu_anon_public_key

# Alias aceptados por el módulo (opcional, mismos valores):
# SUPABASE_URL=
# SUPABASE_KEY=

# Service role (solo servidor / scripts de seed — NUNCA commitear ni exponer en el frontend)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_secret

# Access Token personal (https://supabase.com/dashboard/account/tokens)
# Solo para: npm run supabase:auth-urls  (NO es service_role)
# SUPABASE_ACCESS_TOKEN=sbp_...

# Password de Postgres (scripts npm run db:migrate)
# Supabase → Project Settings → Database → Database password
# NO es la anon key ni la service_role key.
# SUPABASE_DB_PASSWORD=tu_password_de_base

# Alternativa más confiable: pegar la URI completa del pooler (Session mode):
# DATABASE_URL=postgresql://postgres.vxbuafyolbvbxktqbqao:[password]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# URL pública de la app (pagos, redirects, SEO)
# En Vercel: https://emerge-group-consultora.vercel.app (o tu dominio)
NUXT_PUBLIC_APP_URL=https://emerge-group-consultora.vercel.app

# --- Correo de avisos del buzón (recomendado: Gmail SMTP, gratis) ---
# 1) Cuenta Gmail → Seguridad → Verificación en 2 pasos (activar)
# 2) Contraseñas de aplicaciones → generar una para "Campus / Mail"
# 3) Pegar abajo (NO uses la contraseña normal de Gmail)
# SMTP_USER=campus.emerge@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=Emerge Group · Campus <campus.emerge@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
#
# IMAP (mismas credenciales; por defecto usa SMTP_USER/SMTP_PASS):
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# En Gmail: Configuración → Ver todos → Reenvío y correo POP/IMAP → Habilitar IMAP
#
# Cron Vercel (recomendado):
# CRON_SECRET=generá-un-string-largo
#
# Límite típico Gmail gratuito: ~100–500 mails/día (suficiente para avisos del campus).
# Alias opcionales: GMAIL_USER / GMAIL_APP_PASSWORD
#
# Resend solo sirve bien CON dominio verificado. Sin dominio, solo manda a 1 mail.
# RESEND_API_KEY=
# RESEND_FROM=Emerge Group · Campus <noreply@tudominio.com>

# Contacto (opcional — sobreescriben app/app.config.ts sin tocar código)
# NUXT_PUBLIC_CONTACT_EMAIL=contacto@tu-dominio.com
# NUXT_PUBLIC_CONTACT_WHATSAPP=5493704297563

# Redes sociales: editar app/app.config.ts → social.linkedin, instagram, etc.

# Mercado Pago (opcional — dejar comentado si no usás pagos aún)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_SANDBOX=true

# Pruebas automáticas (scripts/smoke-test-comms.mjs) — usuarios de dev, no producción
# TEST_CAMPUS_EMAIL=alumno@ejemplo.com
# TEST_CAMPUS_PASSWORD=tu_password
# TEST_CAMPUS_STAFF_EMAIL=admin@ejemplo.com
# TEST_CAMPUS_STAFF_PASSWORD=tu_password
